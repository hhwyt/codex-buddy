{
  "name": "codex-buddy",
  "version": "26.11.2",
  "description": "CodexBuddy：一键装好 Codex，免费用 AI",
  "author": "hhwyt",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "build": "node -e \"for (const dir of ['dist', 'ui/build']) require('node:fs').rmSync(dir, { recursive: true, force: true })\" && tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "lint": "npm run typecheck && node scripts/lint-scan.mjs",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "check:ids": "node scripts/check-spec-ids.mjs",
    "preview": "scripts/preview.sh",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "dist:drive": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder -c build/drive.config.cjs --publish never",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "38.4.0",
    "electron-builder": "26.8.1",
    "happy-dom": "^21.0.4",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "app.codexbuddy",
    "productName": "CodexBuddy",
    "executableName": "CodexBuddy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "dist/**/*.js",
      "ui/index.html",
      "ui/*.css",
      "ui/build/**/*.js",
      "ui/assets/**",
      "remote/config.json",
      "scripts/vendor/codex.ps1"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "asarUnpack": [
      "scripts/vendor/codex.ps1"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "CodexBuddy",
      "artifactName": "CodexBuddy-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "artifactName": "CodexBuddy-${version}.dmg",
      "title": "CodexBuddy ${version}"
    }
  }
}
